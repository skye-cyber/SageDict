{
  "name": "sagedict",
  "version": "1.0.0",
  "description": "A lightweight english desktop dictionary app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:react": "vite --host 0.0.0.0",
    "dev:styles": "tailwindcss -i ./src/ui/styles/config.css -o ./src/ui/styles/global.css --watch",
    "dev:types": "tsc --noEmit --watch",
    "dev:core": "tsc -p tsconfig.core.json --watch",
    "dev:tauri": "tauri dev",
    "build": "npm run clean && npm run type-check && npm run build:all",
    "build:all": "npm-run-all build:core build:react build:tauri",
    "build:core": "tsc -p tsconfig.core.json",
    "build:react": "vite build",
    "build:tauri": "tauri build",
    "package": "npm run build",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "styles": "tailwindcss -i ./src/ui/styles/config.css -o ./src/ui/styles/global.css --minify",
    "tauri": "tauri",
    "cert:gen": "keytool -genkey -v -keystore ~/sagedict-upload-keystore.jks -alias sagedict -keyalg RSA -keysize 2048 -validity 10000"
  },
  "keywords": [
    "dictionary",
    "desktop",
    "tauri"
  ],
  "author": {
    "name": "Wambua Mwikya aka Skye",
    "email": "swskye17@gmail.com"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.5",
    "framer-motion": "^14.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0"
  }
}
